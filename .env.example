# ==== Django ====
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# ==== Database（本番はNeon等のPostgres接続文字列。未設定ならSQLiteで動作） ====
# 例: postgresql://user:password@ep-xxxx.ap-northeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ==== Email（Gmail SMTP。Googleアカウントの「アプリパスワード」を発行して設定） ====
EMAIL_USE_CONSOLE=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-alert-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-alert-address@gmail.com

# ==== アプリ設定 ====
SITE_BASE_URL=https://your-app.onrender.com
FREE_PLAN_COMPANY_LIMIT=100
CRAWLER_CONTACT_EMAIL=you@example.com
CRAWLER_MIN_DOMAIN_INTERVAL_SECONDS=3
CRAWLER_REQUEST_TIMEOUT_SECONDS=10
CRAWLER_MAX_RETRIES=2
CRAWLER_CIRCUIT_BREAKER_FAILURES=5
CRAWLER_BATCH_SIZE=25
